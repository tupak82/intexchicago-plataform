# Owned Hostinger MySQL database. Apply db/schema.sql before enabling production forms.
INTEX_DB_HOST=
INTEX_DB_PORT=3306
INTEX_DB_USER=
INTEX_DB_PASSWORD=
INTEX_DB_NAME=

# Optional lead notification / CRM webhook. MySQL can be the primary persistence layer.
INTEX_LEADS_WEBHOOK_URL=
INTEX_LEADS_WEBHOOK_SECRET=

# Admin Control Center. Keep disabled until all three values are configured.
INTEX_ADMIN_ENABLED=false
INTEX_ADMIN_PASSWORD=
INTEX_ADMIN_SESSION_SECRET=

# Optional production SEO / analytics hooks. Leave blank until approved IDs exist.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=
